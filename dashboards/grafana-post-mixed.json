{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "aixboms-pollen-mixed-charts"
  },
  "spec": {
    "title": "AixBOMS Pollen Mixed Charts",
    "editable": true,
    "cursorSync": "Off",
    "liveNow": false,
    "preload": false,
    "tags": ["aixboms"],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "annotations": [],
    "links": [],
    "variables": [],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Pollen — Daily MIN/MAX Band",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "yesoreyeram-infinity-datasource",
                      "version": "v0",
                      "datasource": { "name": "aixboms-rest" },
                      "spec": {
                        "columns": [
                          {
                            "selector": "time",
                            "text": "time",
                            "type": "timestamp_epoch"
                          },
                          {
                            "selector": "sensor",
                            "text": "sensor",
                            "type": "string"
                          },
                          {
                            "selector": "MIN",
                            "text": "Min. Power",
                            "type": "number"
                          },
                          {
                            "selector": "MAX",
                            "text": "Max. Power",
                            "type": "number"
                          }
                        ],
                        "filters": [],
                        "format": "table",
                        "parser": "backend",
                        "root_selector": "",
                        "source": "url",
                        "type": "json",
                        "url": "/aixboms/rest/sensordata/grafana/query?sensors=AP-DUS-BIL-DC01-GF-01&startTime=${__from:date:seconds}&endTime=${__to:date:seconds}&aggregateFunction=MIN&aggregateFunction=MAX&aggregationWindow=DAY",
                        "url_options": {
                          "body_content_type": "text/plain",
                          "body_type": "raw",
                          "data": "",
                          "method": "GET"
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "v0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": { "mode": "palette-classic" },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "value": 0, "color": "green" },
                      { "value": 80, "color": "red" }
                    ]
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "stepAfter",
                    "lineWidth": 1,
                    "fillOpacity": 40,
                    "gradientMode": "none",
                    "pointSize": 5,
                    "spanNulls": false,
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "scaleDistribution": { "type": "linear" },
                    "showPoints": "auto",
                    "showValues": false,
                    "stacking": { "group": "A", "mode": "none" },
                    "thresholdsStyle": { "mode": "off" }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "New Employees — Weekly",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "yesoreyeram-infinity-datasource",
                      "version": "v0",
                      "datasource": { "name": "aixboms-rest" },
                      "spec": {
                        "columns": [
                          {
                            "selector": "EntryDate",
                            "text": "EntryDate",
                            "type": "timestamp_epoch"
                          },
                          {
                            "selector": "Count_Id",
                            "text": "New Employee Count",
                            "type": "number"
                          }
                        ],
                        "filters": [],
                        "format": "table",
                        "parser": "backend",
                        "root_selector": "",
                        "source": "url",
                        "type": "json",
                        "url": "/aixboms/rest/query/grafana/execute/aggregate?view=CCKTBIPersonStdView&filter=EntryDate != null&groupBy=EntryDate:WEEK&aggregate=Id:COUNT&orderBy=EntryDate:ASC",
                        "url_options": {
                          "body_content_type": "text/plain",
                          "body_type": "raw",
                          "data": "",
                          "method": "GET"
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "v0",
            "spec": {
              "options": {
                "barRadius": 0,
                "barWidth": 0.9,
                "color": { "mode": "palette-classic" },
                "colorByField": "",
                "fullHighlight": false,
                "groupWidth": 0.8,
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "orientation": "auto",
                "showValue": "auto",
                "stacking": "none",
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                },
                "xField": "",
                "xTickLabelRotation": 0,
                "xTickLabelSpacing": 50
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": { "mode": "palette-classic" },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "value": 0, "color": "green" },
                      { "value": 80, "color": "red" }
                    ]
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "lineWidth": 1,
                    "scaleDistribution": { "type": "linear" },
                    "thresholdsStyle": { "mode": "off" }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Components by Category",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "yesoreyeram-infinity-datasource",
                      "version": "v0",
                      "datasource": { "name": "aixboms-rest" },
                      "spec": {
                        "columns": [
                          {
                            "selector": "Count_Id",
                            "text": "Component Count",
                            "type": "number"
                          },
                          {
                            "selector": "Category1",
                            "text": "Class",
                            "type": "string"
                          }
                        ],
                        "filters": [],
                        "format": "table",
                        "parser": "backend",
                        "root_selector": "",
                        "source": "url",
                        "type": "json",
                        "url": "/aixboms/rest/query/grafana/execute/aggregate?view=CCKTCICompView&filter=Category1 != null&groupBy=Category1&aggregate=Id:COUNT&orderBy=Category1",
                        "url_options": {
                          "body_content_type": "text/plain",
                          "body_type": "raw",
                          "data": "",
                          "method": "GET"
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "v0",
            "spec": {
              "options": {
                "displayLabels": [],
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "values": ["percent"]
                },
                "pieType": "donut",
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "/^Component Count$/",
                  "values": true
                },
                "sort": "desc",
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": { "mode": "palette-classic" },
                  "custom": {
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "AutoGridLayout",
      "spec": {
        "maxColumnCount": 3,
        "columnWidthMode": "standard",
        "rowHeightMode": "standard",
        "items": [
          {
            "kind": "AutoGridLayoutItem",
            "spec": {
              "element": { "kind": "ElementReference", "name": "panel-1" }
            }
          },
          {
            "kind": "AutoGridLayoutItem",
            "spec": {
              "element": { "kind": "ElementReference", "name": "panel-2" }
            }
          },
          {
            "kind": "AutoGridLayoutItem",
            "spec": {
              "element": { "kind": "ElementReference", "name": "panel-3" }
            }
          }
        ]
      }
    }
  }
}
